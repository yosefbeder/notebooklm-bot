BOT_TOKEN=
# Empty means api.telegram.org. Production: e.g. http://127.0.0.1:8081
TELEGRAM_API_BASE=
# Enable only when the local Bot API's files are accessible to this process.
TELEGRAM_LOCAL_FILES=false
# If needed, map the API server's file root to this process's mount.
TELEGRAM_FILE_ROOT=
TELEGRAM_MOUNT_ROOT=
# Strongly recommended: comma-separated Telegram user IDs. Empty allows all private chats.
ALLOWED_USER_IDS=
DATABASE_URL=sqlite+aiosqlite:///data/bot.sqlite3
DATA_DIR=data
# Install/authenticate notebooklm-mcp-cli separately. Stdio shares this filesystem.
MCP_COMMAND=notebooklm-mcp
# Use this same Google session storage path for nlm login.
NOTEBOOKLM_MCP_CLI_PATH=./data/notebooklm
MCP_ARGS=[]
MCP_TIMEOUT_SECONDS=240
GENERATION_TIMEOUT_SECONDS=1800
SOURCE_TIMEOUT_SECONDS=900
# Optional font for full Unicode in exported PDFs.
PDF_FONT_PATH=
